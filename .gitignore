# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan
*.plan

# Sensitive variable files
*.tfvars
*.tfvars.json

# Lock file (keep if working in team)
# Uncomment below if you DON'T want to track it
# .terraform.lock.hcl

# Editor files
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db